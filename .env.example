# Machine Identification
MACHINE_ID=3_station
OPERATOR_NAME=Operator_1
SWIFT=

# Siemens PLC Configuration
PLC_IP=192.168.50.11
PLC_RACK=0
PLC_SLOT=1
PLC_DB_NUMBER=1000
PLC_BYTE_START=0
PLC_BYTE_SIZE=37
PLC_POLL_INTERVAL=0.1
PLC_RECONNECT_DELAY=3.0

# SQL Server Configuration
SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=HydraulicMachineDB
SQL_TABLE_NAME=MachineDataLog
SQL_TRUSTED_CONNECTION=true
SQL_USER=
SQL_PASSWORD=
SQL_TIMEOUT=5

# Data Logging Intervals - 100ms
SQL_IO_LOG_INTERVAL=0.1
SQL_BUFFER_MAX_SIZE=50000

# PLC Alarm Configuration (DB 101)
PLC_ALARM_DB=101
PLC_ALARM_DB_FALLBACK=1011
PLC_ALARM_START_BYTE=0
PLC_ALARM_BYTE_COUNT=64
PLC_ALARM_BYTE_SWAP=false
ALARM_MAPPINGS_DB=data/alarm_mappings.sqlite
RECIPE_NAME=Standard_Recipe
MACHINE_MODE=AUTO
WEB_PORT=5001

